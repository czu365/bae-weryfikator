# Wygeneruj .env i secrets/ poleceniem python3 scripts/init_secrets.py.
# Host i origin muszą odpowiadać nazwie DNS i zaufanemu TLS.
APP_ORIGIN=https://localhost
APP_HOST=localhost
# Ustaw grupę plików w secrets/; init_secrets.py wpisuje ją automatycznie.
BAE_SECRET_GID=1000
# Opcjonalnie dla preprovisionowanych kont domenowych:
# LDAP_HOST=ldap.example.test
# LDAP_DOMAIN=example.test
# LDAP_CA_FILE=/run/bae/ad-ca.pem
